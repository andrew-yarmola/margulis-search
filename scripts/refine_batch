#!/bin/bash

out_dir="batch"

m_bnd=1.34
r_bnd=1.476

while read b
do
  echo "$b"
  echo 0 | ../bin/refine_marg --fill_holes --box "$b" --max_depth 150 --truncate_depth 6 --invent_depth 70 --max_size 3000000 --words ../words --word_search_depth 6 -m $m_bnd -r $r_bnd --impossible ../impossible > "$out_dir/${b}.out" 2> "$out_dir/${b}.err"
done
